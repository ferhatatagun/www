# ferhatatagun.com — static site serving rules
#
# The site is fully prerendered: every real page exists on disk as
# `<path>.html`. Two things this file has to get right.
#
# 1. Missing URLs must 404.
#    Before this file existed the host answered 200 or 500 for paths that
#    don't exist — /skills/PoolsApi.md returned 200 with the Skills page,
#    /blog/anything-invalid returned 500. Search Console reported ten of
#    those as "server error (5xx)". A 200 on a URL that isn't real is
#    duplicate content Google will index; a 500 signals an unhealthy site
#    and suppresses crawl rate.
#
# 2. Canonical URLs must resolve in one hop.
#    The adapter emits BOTH `tools.html` and a `tools/` directory (the
#    latter holds child pages). If the directory is matched first, mod_dir
#    issues a 301 to `/tools/` — so every canonical URL on the site cost a
#    redirect. The .html twin is therefore checked BEFORE the directory,
#    and DirectorySlash is off so mod_dir never adds a slash on its own.

Options -MultiViews
DirectoryIndex index.html

<IfModule mod_dir.c>
  # Without this, a request for /tools (a real directory) is 301'd to
  # /tools/ before our rewrite gets a chance to serve tools.html.
  DirectorySlash Off
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On

  # 1. Exact file on disk — serve it.
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # 2. Prerendered twin. Checked before the directory test so /tools maps
  #    to tools.html rather than redirecting into the tools/ directory.
  #    No leading slash in the substitution: that would turn an internal
  #    rewrite into an external 301.
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.+?)/?$ $1.html [L]

  # 3. Directory with its own index.
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^(.+?)/?$ $1/index.html [L]

  # 4. Any other real directory (assets, og-cards, …).
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # 5. Nothing matched — the URL is genuinely missing.
  RewriteRule ^ - [R=404,L]
</IfModule>

ErrorDocument 404 /404.html

# Hashed build assets never change under the same name; HTML must always be
# revalidated so a deploy is visible immediately.
<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(js|css|woff2|png|jpg|jpeg|svg|webp|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(xml|txt)$">
    Header set Cache-Control "public, max-age=3600"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json image/svg+xml
</IfModule>
